rules_version = '2';

// Reglas de seguridad de DNI GYM
// - Cada usuario solo puede leer/escribir sus propios datos.
// - Los administradores (documento admins/{email}) pueden leer todo y bloquear cuentas.
// - Los eventos (analítica y errores) se pueden crear sin sesión, con un esquema validado, y solo los lee un admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(email()));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function notBlocked(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('blocked', false) == false;
    }

    // Lista de administradores: se gestiona solo desde la consola de Firebase.
    match /admins/{adminEmail} {
      allow read: if signedIn() && (email() == adminEmail || isAdmin());
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('blocked', false) == false;
      // el usuario no puede cambiar su estado de bloqueo, su uid ni su fecha de alta
      allow update: if (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked', 'uid', 'createdAt']))
        || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // workouts, body, nutrition
      match /{collection}/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && notBlocked(uid)
          && collection in ['workouts', 'body', 'nutrition'];
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    match /events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'ts', 'uid', 'email', 'name', 'code', 'message', 'path', 'ua', 'ref'])
        && request.resource.data.type in ['signup', 'login', 'logout', 'auth_error', 'client_error', 'visit', 'workout_completed', 'account_deleted']
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts < request.time.toMillis() + 300000
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
        && (!('message' in request.resource.data) || request.resource.data.message.size() <= 500)
        && (!('ua' in request.resource.data) || request.resource.data.ua.size() <= 300)
        && (!('path' in request.resource.data) || request.resource.data.path.size() <= 200);
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
